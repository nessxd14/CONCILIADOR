# Cartera única: Cation + esquema hermes.
# Configurar después de habilitar y verificar la API y conciliar el historial.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publicable del proyecto>
NEXT_PUBLIC_SUPABASE_SCHEMA=hermes

# Solo servidor. Exclusiva para ingesta heredada de agentes con permisos limitados.
# La asociación normal de comprobantes usa la sesión del usuario y una RPC.
SUPABASE_SERVICE_ROLE_KEY=<service role del proyecto>

# Vista sintética únicamente en desarrollo.
HERMES_UI_PREVIEW=1
